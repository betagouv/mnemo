NODE_ENV=development
MNEMO_AUTH_MODE=development
MNEMO_DEPLOYMENT_ENV=local
MNEMO_WEB_PORT=3200
MNEMO_ARCHITECTURE_PORT=3202
MNEMO_POSTGRES_PORT=5436
MNEMO_MINIO_PORT=9200
MNEMO_MINIO_CONSOLE_PORT=9201
MNEMO_IFC_SERVER_PORT=3301
MNEMO_IFC_MCP_PORT=8765
DATABASE_URL=postgresql://mnemo:mnemo@localhost:5436/mnemo
S3_ENDPOINT=https://s3.eu-west-par.io.cloud.ovh.net
S3_DOCKER_ENDPOINT=https://s3.eu-west-par.io.cloud.ovh.net
S3_PUBLIC_ENDPOINT=https://s3.eu-west-par.io.cloud.ovh.net
S3_REGION=eu-west-par
S3_BUCKET=replace-with-your-bucket
S3_ACCESS_KEY=replace-with-your-access-key
S3_SECRET_KEY=replace-with-your-secret-key
IFC_LITE_PUBLIC_URL=http://localhost:3301
IFC_LITE_SERVER_URL=http://localhost:3301
IFC_BROWSER_PROCESSING_MAX_BYTES=26214400
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.7-flash
OPENROUTER_APP_URL=http://localhost:3200
IFC_MCP_URL=http://localhost:8765
IFC_MCP_TOKEN=replace-with-a-long-random-token
IFC_MCP_CACHE_DIR=/tmp/mnemo-ifc-mcp-models
IFC_MCP_MODEL_DIR=/tmp/mnemo-ifc-mcp-models
IFC_MCP_MAX_SESSIONS=2
POTREE_CONVERTER_PATH=/usr/local/bin/PotreeConverter
WORKER_POLL_INTERVAL_MS=3000
WORKER_LEASE_TIMEOUT_MS=900000
WORKER_RETRY_BASE_DELAY_MS=5000
