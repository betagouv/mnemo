{
  "name": "@mnemo/processing-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "pnpm --filter @mnemo/database db:generate",
    "build": "tsup && node scripts/copy-parquet-wasm.mjs",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src tsup.config.ts vitest.integration.config.ts",
    "start": "node dist/index.js",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "tsup": "8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "5.0.0"
  },
  "dependencies": {
    "@mnemo/database": "workspace:*",
    "@mnemo/domain": "workspace:*",
    "@mnemo/ifc-processing-adapter": "workspace:*",
    "@mnemo/point-cloud-processing-adapter": "workspace:*",
    "@mnemo/storage": "workspace:*",
    "parquet-wasm": "0.7.2"
  }
}
