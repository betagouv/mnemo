{
  "name": "@mnemo/processing-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./web-background": "./src/web-background.ts"
  },
  "scripts": {
    "prebuild": "pnpm --filter @mnemo/database db:generate",
    "build": "tsup",
    "package:scalingo": "node scripts/package-scalingo.mjs",
    "lint": "eslint src tsup.config.ts vitest.integration.config.ts",
    "start": "node dist/process-point-cloud-once.js",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "tsup": "8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "5.0.0"
  },
  "dependencies": {
    "@mnemo/database": "workspace:*",
    "@mnemo/domain": "workspace:*",
    "@mnemo/storage": "workspace:*",
    "zod": "4.5.4"
  }
}
