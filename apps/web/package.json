{
  "name": "@mnemo/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "react-dsfr update-icons",
    "dev": "next dev --webpack",
    "dev:e2e": "next dev --webpack --hostname 127.0.0.1 --port 3100",
    "prebuild": "react-dsfr update-icons",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@codegouvfr/react-dsfr": "1.34.0",
    "@mnemo/contracts": "workspace:*",
    "@mnemo/database": "workspace:*",
    "@mnemo/domain": "workspace:*",
    "@mnemo/ifc-viewer-adapter": "workspace:*",
    "@mnemo/storage": "workspace:*",
    "@tanstack/react-query": "5.102.8",
    "@trpc/client": "11.18.0",
    "@trpc/server": "11.18.0",
    "@trpc/tanstack-react-query": "11.18.0",
    "client-only": "0.0.1",
    "drizzle-orm": "0.45.2",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "sass": "1.104.0",
    "typescript": "^5",
    "vitest": "5.0.0"
  }
}
