{
  "name": "@mnemo/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "react-dsfr update-icons",
    "dev": "next dev --webpack",
    "dev:e2e": "next dev --webpack --hostname 127.0.0.1 --port 3100",
    "prebuild": "pnpm --filter @mnemo/database db:generate && react-dsfr update-icons",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@assistant-ui/ai-sdk": "0.0.4",
    "@assistant-ui/react": "0.15.18",
    "@assistant-ui/react-markdown": "0.14.14",
    "@codegouvfr/react-dsfr": "1.34.0",
    "@mnemo/bcf-adapter": "workspace:*",
    "@mnemo/contracts": "workspace:*",
    "@mnemo/database": "workspace:*",
    "@mnemo/domain": "workspace:*",
    "@mnemo/ifc-viewer-adapter": "workspace:*",
    "@mnemo/storage": "workspace:*",
    "@openrouter/ai-sdk-provider": "3.0.0",
    "@ai-sdk/mcp": "2.0.47",
    "ai": "^7.0.96",
    "client-only": "0.0.1",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "postcss": "8.5.29",
    "sass": "1.104.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "5.0.0"
  }
}
