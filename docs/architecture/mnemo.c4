specification {
  element actor {
    style {
      shape person
    }
  }
  element application
  element service
  element component
  element database
  element storage
}

model {
  user = actor 'Utilisateur'

  browser = application 'Navigateur' {
    technology 'React, DSFR, WebGPU'

    workspace = component 'Espace projets' 'Pages, formulaires et panneaux'
    viewer = component 'Scène de projet' 'Contrôleur WebGPU unique, couches IFC fédérées, relevés 3D LOD et panneaux DSFR'
    assistantUi = component 'Chat' 'assistant-ui et outils de scène'
  }

  web = application 'Application Mnemo' {
    technology 'Next.js App Router'

    pages = component 'Server Components' 'Projet, fichiers prêts, réglages, BCF et fils de conversation'
    actions = component 'Server Actions' 'Mutations validées par Zod'
    reads = component 'Route Handlers' 'Accès autorisé aux originaux, sources point cloud et flux IFC'
    protocols = component 'Routes dédiées' 'Streaming assistant et archives BCF'
    usecases = component 'Services applicatifs' 'Autorisations et règles métier'
    adapters = component 'Adaptateurs' 'Prisma, S3, BCF et IFC-Lite MCP'
    jobs = component 'Orchestrateur de jobs' 'Réservations PostgreSQL, reprises et déclenchement COPC à la demande'
  }

  copc = service 'COPC one-off' 'Conversion LAS/LAZ ponctuelle, sans connexion à PostgreSQL' {
    technology 'Untwine, S3'
  }
  rust = service 'IFC-Lite Rust + passerelle' 'Lit le S3 signé et streame la géométrie Parquet'
  mcp = service 'IFC-Lite MCP' 'Requêtes sémantiques IFC en lecture seule'
  openrouter = service 'OpenRouter' 'Modèle LLM externe'
  postgres = database 'PostgreSQL' 'Projets, membres, fichiers, jobs, alignements, BCF et conversations'
  minio = storage 'MinIO / S3' 'Originaux IFC et nuages, COPC et screenshots BCF'

  user -> browser.workspace 'gère ses projets et fichiers'
  user -> browser.viewer 'inspecte la scène'
  user -> browser.assistantUi 'pose des questions'

  browser.workspace -> web.pages 'navigue'
  browser.workspace -> web.actions 'crée, téléverse, supprime et annote'
  browser.workspace -> minio 'envoie les originaux par URL signée'
  browser.viewer -> web.reads 'obtient des URLs signées et les réglages'
  browser.viewer -> minio 'lit les petits IFC et COPC par URL signée'
  browser.viewer -> web.reads 'reçoit les lots Parquet et le modèle des gros IFC'
  browser.assistantUi -> web.protocols 'ouvre un flux de chat'
  browser.assistantUi -> browser.viewer 'applique les outils visuels'

  web.pages -> web.usecases 'lit les données initiales'
  web.actions -> web.usecases 'exécute les mutations'
  web.reads -> web.usecases 'autorise les lectures'
  web.protocols -> web.usecases 'autorise les échanges'
  web.usecases -> web.adapters 'utilise les ports métier'
  web.adapters -> postgres 'lit et écrit les métadonnées'
  web.adapters -> minio 'signe les accès et lit les originaux'
  web.reads -> rust 'demande le parsing via URL GET S3 signée'
  rust -> minio 'lit les originaux IFC directement'
  web.jobs -> postgres 'réserve les jobs et publie les résultats'
  web.jobs -> minio 'vérifie les résultats et supprime les objets'
  web.jobs -> copc 'lance une conversion à la demande'
  copc -> minio 'lit le LAS/LAZ et écrit le COPC'
  web.protocols -> openrouter 'streaming LLM'
  web.protocols -> mcp 'interroge la sémantique IFC'
  web.adapters -> mcp 'alimente un cache IFC jetable'

}

views {
  view index {
    title 'Mnemo — vue d’ensemble'
    description 'Runtimes, sources de vérité et dépendances externes.'
    include user, browser, web, copc, rust, mcp, openrouter, postgres, minio
  }

  view application {
    title 'Frontières du monolithe Next.js'
    description 'UI React, transports Next.js, services métier et adaptateurs de stockage.'
    include browser.*, web.*, postgres, minio, mcp, openrouter
  }

  dynamic view upload {
    title 'Téléversement et traitement asynchrone'
    description 'L’IFC est prêt dès le dépôt ; seul le LAS/LAZ demande une conversion COPC ponctuelle.'
    user -> browser.workspace 'choisit un IFC ou un nuage de points'
    browser.workspace -> web.actions 'demande une URL de dépôt'
    web.actions -> web.usecases 'vérifie le projet et prépare le fichier'
    web.usecases -> postgres 'crée le fichier en attente'
    web.usecases -> minio 'signe le dépôt'
    web.actions -> browser.workspace 'renvoie l’URL signée'
    browser.workspace -> minio 'PUT de l’original, directement'
    browser.workspace -> web.actions 'confirme le dépôt'
    web.usecases -> minio 'vérifie la taille de l’objet'
    web.usecases -> postgres 'marque l’IFC prêt ou enfile un job LAS/LAZ'
    web.jobs -> postgres 'réserve le job LAS/LAZ'
    web.jobs -> copc 'lance le one-off avec la clé S3'
    copc -> minio 'lit l’original et écrit le COPC'
    web.jobs -> minio 'vérifie les artefacts publiés'
    web.jobs -> postgres 'publie le résultat et le statut'
  }

  dynamic view rendering {
    title 'Ouverture IFC et nuage de points'
    description 'Un projet réunit plusieurs IFC et relevés 3D dans un seul renderer et une seule caméra ; le COPC ne charge que les nœuds utiles.'
    user -> browser.viewer 'ouvre la scène du projet'
    web.pages -> browser.viewer 'fournit les fichiers prêts et les réglages initiaux'
    browser.viewer -> web.reads 'demande les sources autorisées de chaque fichier'
    web.reads -> web.usecases 'vérifie les droits du projet'
    web.usecases -> postgres 'lit les fichiers et transformations'
    web.usecases -> minio 'signe originaux et COPC'
    web.reads -> browser.viewer 'URLs et réglages'
    browser.viewer -> minio 'lit les petits IFC et le COPC par plages d’octets'
    browser.viewer -> web.reads 'demande le flux des gros IFC autorisés'
    web.reads -> rust 'transmet une URL GET S3 signée et courte'
    rust -> minio 'lit l’original IFC sans passage par le navigateur'
    rust -> web.reads 'streame les maillages et le modèle'
    web.reads -> browser.viewer 'relaie les lots Parquet progressifs'
    browser.viewer -> browser.viewer 'fédère les IFC, règle les couches et rend avec IFC-Lite WebGPU et LOD'
  }

  dynamic view assistant {
    title 'Chat IFC et actions sur la scène'
    description 'Le MCP lit la sémantique IFC ; les outils visuels restent exécutés dans le viewer.'
    user -> browser.assistantUi 'pose une question'
    browser.assistantUi -> web.protocols 'démarre le flux SSE'
    web.protocols -> web.usecases 'autorise le projet et le fichier IFC'
    web.usecases -> postgres 'lit le fil de conversation'
    web.protocols -> mcp 'exécute des requêtes IFC en lecture seule'
    web.protocols -> openrouter 'génère la réponse et les appels d’outils'
    web.protocols -> postgres 'sauvegarde les messages'
    web.protocols -> browser.assistantUi 'streaming de la réponse'
    browser.assistantUi -> browser.viewer 'sélectionne, isole ou colore'
  }

  dynamic view bcf {
    title 'Remarques BCF et viewpoints'
    description 'Métadonnées transactionnelles dans PostgreSQL, screenshots dans MinIO, import/export par route dédiée.'
    user -> browser.viewer 'crée une remarque sur un élément IFC'
    browser.viewer -> web.actions 'envoie GlobalId, commentaire et viewpoint'
    web.actions -> web.usecases 'autorise et valide la remarque'
    web.usecases -> postgres 'enregistre topic, commentaire et caméra'
    web.usecases -> minio 'signe le dépôt du screenshot'
    browser.viewer -> minio 'envoie le screenshot par URL signée'
    browser.viewer -> web.protocols 'importe ou exporte une archive BCF'
    web.protocols -> web.usecases 'mappe BCF 2.1/3.0 et contrôle les droits'
    web.usecases -> postgres 'lit ou écrit les topics BCF'
    web.usecases -> minio 'lit ou écrit les snapshots'
  }
}
