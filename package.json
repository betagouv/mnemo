{
  "name": "mnemo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @mnemo/web dev",
    "dev:worker": "pnpm --filter @mnemo/processing-worker dev",
    "db:generate": "pnpm --filter @mnemo/database db:generate",
    "db:migrate": "pnpm --filter @mnemo/database db:migrate",
    "db:seed": "pnpm --filter @mnemo/database db:seed",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint && pnpm lint:architecture",
    "lint:architecture": "node scripts/check-fsd-boundaries.mjs",
    "start": "pnpm --filter @mnemo/web start",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @mnemo/web test:e2e",
    "test:integration": "turbo run test:integration",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "turbo": "2.10.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.70.0"
  }
}
