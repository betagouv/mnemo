{
  "name": "mnemo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @mnemo/web dev",
    "dev:worker": "pnpm --filter @mnemo/processing-worker dev",
    "lint": "turbo run lint",
    "start": "pnpm --filter @mnemo/web start",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "^2.5.8",
    "typescript": "^5.9.3"
  }
}
