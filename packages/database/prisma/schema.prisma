generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model asset_processing_results {
  asset_id              String   @id @db.Uuid
  processor             String   @db.VarChar(80)
  processor_version     String   @db.VarChar(80)
  cache_key             String
  entity_count          BigInt
  geometry_entity_count BigInt
  mesh_count            BigInt
  cache_hit             Boolean
  processed_at          DateTime @db.Timestamptz(6)
  created_at            DateTime @default(now()) @db.Timestamptz(6)
  updated_at            DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  assets                assets   @relation(fields: [asset_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "asset_processing_results_asset_id_assets_id_fk")
}

model assets {
  id                             String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id                     String                          @db.Uuid
  kind                           asset_kind
  original_file_name             String                          @db.VarChar(512)
  media_type                     String                          @db.VarChar(255)
  size_bytes                     BigInt
  original_object_key            String                          @unique(map: "assets_original_object_key_unique")
  status                         asset_status                    @default(upload_pending)
  error_message                  String?
  created_by                     String                          @db.Uuid
  upload_expires_at              DateTime                        @db.Timestamptz(6)
  uploaded_at                    DateTime?                       @db.Timestamptz(6)
  created_at                     DateTime                        @default(now()) @db.Timestamptz(6)
  updated_at                     DateTime                        @default(now()) @updatedAt @db.Timestamptz(6)
  asset_processing_results       asset_processing_results?
  users                          users                           @relation(fields: [created_by], references: [id], onUpdate: NoAction, map: "assets_created_by_users_id_fk")
  projects                       projects                        @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "assets_project_id_projects_id_fk")
  assistant_threads              assistant_threads[]
  bcf_topic_components           bcf_topic_components[]
  point_cloud_processing_results point_cloud_processing_results?
  point_cloud_settings           point_cloud_settings?
  floor_plans                    project_floor_plans[]
  map_reference                  project_map_references?
  processing_jobs                processing_jobs[]

  @@index([project_id])
  @@index([status])
}

model assistant_messages {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  thread_id         String            @db.Uuid
  ordinal           Int
  payload           Json
  created_at        DateTime          @default(now()) @db.Timestamptz(6)
  assistant_threads assistant_threads @relation(fields: [thread_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "assistant_messages_thread_id_assistant_threads_id_fk")

  @@unique([thread_id, ordinal], map: "assistant_messages_thread_ordinal_unique")
  @@index([thread_id])
}

model assistant_threads {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id         String               @db.Uuid
  asset_id           String               @db.Uuid
  created_by         String               @db.Uuid
  title              String               @default("Nouvelle conversation") @db.VarChar(160)
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  updated_at         DateTime             @default(now()) @updatedAt @db.Timestamptz(6)
  assistant_messages assistant_messages[]
  assets             assets               @relation(fields: [asset_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "assistant_threads_asset_id_assets_id_fk")
  users              users                @relation(fields: [created_by], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "assistant_threads_created_by_users_id_fk")
  projects           projects             @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "assistant_threads_project_id_projects_id_fk")

  @@index([created_by, project_id, asset_id, updated_at], map: "assistant_threads_context_idx")
}

model bcf_comments {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  topic_id           String     @db.Uuid
  author_id          String     @db.Uuid
  comment            String
  created_at         DateTime   @default(now()) @db.Timestamptz(6)
  bcf_guid           String     @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  external_author    String?    @db.VarChar(320)
  viewpoint_bcf_guid String?    @db.Uuid
  users              users      @relation(fields: [author_id], references: [id], onUpdate: NoAction, map: "bcf_comments_author_id_users_id_fk")
  bcf_topics         bcf_topics @relation(fields: [topic_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "bcf_comments_topic_id_bcf_topics_id_fk")

  @@unique([topic_id, bcf_guid], map: "bcf_comments_topic_guid_unique")
  @@index([topic_id])
}

model bcf_topic_components {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  topic_id   String     @db.Uuid
  asset_id   String?    @db.Uuid
  global_id  String     @db.VarChar(64)
  express_id Int?
  created_at DateTime   @default(now()) @db.Timestamptz(6)
  assets     assets?    @relation(fields: [asset_id], references: [id], onUpdate: NoAction, map: "bcf_topic_components_asset_id_assets_id_fk")
  bcf_topics bcf_topics @relation(fields: [topic_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "bcf_topic_components_topic_id_bcf_topics_id_fk")

  @@index([asset_id])
  @@index([global_id])
  @@index([topic_id])
}

model bcf_topics {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id           String                 @db.Uuid
  number               Int                    @default(autoincrement())
  assigned_to          String?                @db.VarChar(320)
  due_date             DateTime?              @db.Date
  labels               String[]               @default([])
  exchange_metadata    Json?
  modified_author      String?                @db.VarChar(320)
  title                String                 @db.VarChar(255)
  description          String?
  type                 String                 @default("Issue") @db.VarChar(100)
  status               String                 @default("Open") @db.VarChar(100)
  priority             String                 @default("Normal") @db.VarChar(100)
  created_by           String                 @db.Uuid
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  updated_at           DateTime               @default(now()) @updatedAt @db.Timestamptz(6)
  bcf_guid             String                 @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  external_author      String?                @db.VarChar(320)
  bcf_comments         bcf_comments[]
  bcf_topic_components bcf_topic_components[]
  users                users                  @relation(fields: [created_by], references: [id], onUpdate: NoAction, map: "bcf_topics_created_by_users_id_fk")
  projects             projects               @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "bcf_topics_project_id_projects_id_fk")
  bcf_viewpoints       bcf_viewpoints[]

  @@unique([project_id, bcf_guid], map: "bcf_topics_project_guid_unique")
  @@index([project_id])
  @@index([status])
}

model bcf_viewpoints {
  id                     String     @id @db.Uuid
  topic_id               String     @db.Uuid
  data                   Json
  target_distance        Float
  snapshot_object_key    String?
  snapshot_media_type    String?    @db.VarChar(64)
  snapshot_expected_size BigInt?
  snapshot_uploaded_at   DateTime?  @db.Timestamptz(6)
  created_by             String     @db.Uuid
  created_at             DateTime   @default(now()) @db.Timestamptz(6)
  bcf_guid               String     @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  external_author        String?    @db.VarChar(320)
  users                  users      @relation(fields: [created_by], references: [id], onUpdate: NoAction, map: "bcf_viewpoints_created_by_users_id_fk")
  bcf_topics             bcf_topics @relation(fields: [topic_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "bcf_viewpoints_topic_id_bcf_topics_id_fk")

  @@unique([topic_id, bcf_guid], map: "bcf_viewpoints_topic_guid_unique")
  @@index([created_by])
  @@index([topic_id])
}

model deletion_jobs {
  id           String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resource_id  String                @db.Uuid
  type         deletion_job_type
  object_keys  String[]
  status       processing_job_status @default(queued)
  attempts     Int                   @default(0)
  max_attempts Int                   @default(5)
  available_at DateTime              @default(now()) @db.Timestamptz(6)
  locked_at    DateTime?             @db.Timestamptz(6)
  locked_by    String?               @db.VarChar(160)
  completed_at DateTime?             @db.Timestamptz(6)
  last_error   String?
  created_at   DateTime              @default(now()) @db.Timestamptz(6)
  updated_at   DateTime              @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([resource_id, type], map: "deletion_jobs_resource_type_unique")
  @@index([status, available_at], map: "deletion_jobs_poll_idx")
}

model point_cloud_processing_results {
  asset_id          String   @id @db.Uuid
  format            String   @db.VarChar(40)
  processor         String   @db.VarChar(80)
  processor_version String   @db.VarChar(80)
  copc_object_key   String
  point_count       BigInt
  spacing           Float
  processed_at      DateTime @db.Timestamptz(6)
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  updated_at        DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  assets            assets   @relation(fields: [asset_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "point_cloud_processing_results_asset_id_assets_id_fk")

  @@index([processed_at], map: "point_cloud_results_processed_at_idx")
}

model point_cloud_settings {
  asset_id   String   @id @db.Uuid
  position_x Float    @default(0)
  position_y Float    @default(0)
  position_z Float    @default(0)
  rotation_x Float    @default(-90)
  rotation_y Float    @default(0)
  rotation_z Float    @default(0)
  scale_x    Float    @default(1)
  scale_y    Float    @default(1)
  scale_z    Float    @default(1)
  source_crs String?  @db.VarChar(160)
  target_crs String?  @db.VarChar(160)
  updated_by String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  assets     assets   @relation(fields: [asset_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "point_cloud_settings_asset_id_assets_id_fk")
  users      users    @relation(fields: [updated_by], references: [id], onUpdate: NoAction, map: "point_cloud_settings_updated_by_users_id_fk")
}

model processing_jobs {
  progress     Json?
  id           String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  asset_id     String                @db.Uuid
  type         processing_job_type
  status       processing_job_status @default(queued)
  attempts     Int                   @default(0)
  max_attempts Int                   @default(3)
  available_at DateTime              @default(now()) @db.Timestamptz(6)
  locked_at    DateTime?             @db.Timestamptz(6)
  locked_by    String?               @db.VarChar(160)
  completed_at DateTime?             @db.Timestamptz(6)
  last_error   String?
  created_at   DateTime              @default(now()) @db.Timestamptz(6)
  updated_at   DateTime              @default(now()) @updatedAt @db.Timestamptz(6)
  assets       assets                @relation(fields: [asset_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "processing_jobs_asset_id_assets_id_fk")

  @@unique([asset_id, type], map: "processing_jobs_asset_type_unique")
  @@index([status, available_at], map: "processing_jobs_poll_idx")
}

model project_members {
  project_id   String                       @db.Uuid
  user_id      String                       @db.Uuid
  role         project_role                 @default(viewer)
  joined_at    DateTime                     @default(now()) @db.Timestamptz(6)
  projects     projects                     @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "project_members_project_id_projects_id_fk")
  users        users                        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "project_members_user_id_users_id_fk")
  custom_roles project_member_roles[]
  permissions  project_member_permissions[]

  @@id([project_id, user_id], map: "project_members_project_id_user_id_pk")
  @@index([project_id])
  @@index([user_id])
}

model project_invitations {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id  String       @db.Uuid
  email       String       @db.VarChar(320)
  token_hash  String       @unique @db.VarChar(64)
  base_role   project_role
  role_ids    String[]     @default([])
  permissions String[]     @default([])
  expires_at  DateTime     @db.Timestamptz(6)
  created_at  DateTime     @default(now()) @db.Timestamptz(6)
  invited_by  String       @db.Uuid
  projects    projects     @relation(fields: [project_id], references: [id], onDelete: Cascade)
  users       users        @relation(fields: [invited_by], references: [id], onDelete: Cascade)

  @@unique([project_id, email])
  @@index([expires_at])
}

model projects {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title                String                 @db.VarChar(160)
  address              String?                @db.VarChar(320)
  description          String?
  created_by           String                 @db.Uuid
  archived_at          DateTime?              @db.Timestamptz(6)
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  updated_at           DateTime               @default(now()) @updatedAt @db.Timestamptz(6)
  assets               assets[]
  assistant_threads    assistant_threads[]
  bcf_topics           bcf_topics[]
  bcf_options          Json?
  bcf_snapshot_uploads bcf_snapshot_uploads[]
  project_members      project_members[]
  project_invitations  project_invitations[]
  project_roles        project_roles[]
  users                users                  @relation(fields: [created_by], references: [id], onUpdate: NoAction, map: "projects_created_by_users_id_fk")
  measurements         project_measurements[]
  floor_plans          project_floor_plans[]
  bim_filters          project_bim_filters?
  map_reference        project_map_references?

  @@index([created_by])
}

model users {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                String                 @unique(map: "users_email_unique") @db.VarChar(320)
  display_name         String                 @db.VarChar(160)
  email_verified       Boolean                @default(false)
  roles                user_role[]            @default([user])
  approved_at          DateTime?              @db.Timestamptz(6)
  approved_by          String?                @db.Uuid
  approver             users?                 @relation("account_approvals", fields: [approved_by], references: [id], onDelete: SetNull)
  approved_accounts    users[]                @relation("account_approvals")
  image                String?
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  updated_at           DateTime               @default(now()) @updatedAt @db.Timestamptz(6)
  assets               assets[]
  assistant_threads    assistant_threads[]
  bcf_comments         bcf_comments[]
  bcf_topics           bcf_topics[]
  bcf_viewpoints       bcf_viewpoints[]
  point_cloud_settings point_cloud_settings[]
  project_members      project_members[]
  project_invitations  project_invitations[]
  projects             projects[]
  measurements         project_measurements[]
  auth_sessions        auth_sessions[]
  auth_accounts        auth_accounts[]
  bcf_snapshot_uploads bcf_snapshot_uploads[]

  @@index([approved_at, created_at(sort: Desc)])
}

model auth_sessions {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  token      String   @unique
  expires_at DateTime @db.Timestamptz(6)
  ip_address String?
  user_agent String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  user       users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model auth_accounts {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                  String    @db.Uuid
  account_id               String
  provider_id              String
  access_token             String?
  refresh_token            String?
  access_token_expires_at  DateTime? @db.Timestamptz(6)
  refresh_token_expires_at DateTime? @db.Timestamptz(6)
  scope                    String?
  id_token                 String?
  password                 String?
  created_at               DateTime  @default(now()) @db.Timestamptz(6)
  updated_at               DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  user                     users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider_id, account_id])
  @@index([user_id])
}

model auth_verifications {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expires_at DateTime @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([identifier])
}

model auth_rate_limits {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")
}

model project_roles {
  id          String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id  String                     @db.Uuid
  name        String                     @db.VarChar(80)
  created_at  DateTime                   @default(now()) @db.Timestamptz(6)
  projects    projects                   @relation(fields: [project_id], references: [id], onDelete: Cascade)
  permissions project_role_permissions[]
  members     project_member_roles[]

  @@unique([project_id, name])
  @@unique([project_id, id])
}

model project_role_permissions {
  role_id    String        @db.Uuid
  permission String        @db.VarChar(80)
  role       project_roles @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([role_id, permission])
}

model project_member_roles {
  project_id String          @db.Uuid
  user_id    String          @db.Uuid
  role_id    String          @db.Uuid
  member     project_members @relation(fields: [project_id, user_id], references: [project_id, user_id], onDelete: Cascade)
  role       project_roles   @relation(fields: [project_id, role_id], references: [project_id, id], onDelete: Cascade)

  @@id([project_id, user_id, role_id])
}

model project_member_permissions {
  project_id String          @db.Uuid
  user_id    String          @db.Uuid
  permission String          @db.VarChar(80)
  member     project_members @relation(fields: [project_id, user_id], references: [project_id, user_id], onDelete: Cascade)

  @@id([project_id, user_id, permission])
}

enum asset_kind {
  ifc
  point_cloud
}

enum asset_status {
  upload_pending
  uploaded
  processing
  ready
  failed
  deleting
}

enum deletion_job_type {
  delete_bcf_upload
  delete_asset
  delete_project
}

enum processing_job_status {
  queued
  running
  succeeded
  failed
}

enum processing_job_type {
  process_point_cloud
}

enum project_role {
  owner
  editor
  viewer
}

// Short-lived upload receipts. Object keys are generated exclusively by the server.
model bcf_snapshot_uploads {
  id         String   @id @db.Uuid
  project_id String   @db.Uuid
  actor_id   String   @db.Uuid
  object_key String   @unique
  media_type String   @db.VarChar(64)
  size_bytes Int
  expires_at DateTime @db.Timestamptz(6)
  projects   projects @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users    @relation(fields: [actor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expires_at])
}

model project_floor_plans {
  id           String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id   String                 @db.Uuid
  asset_id     String                 @db.Uuid
  name         String                 @db.VarChar(160)
  storey_id    Int
  storey_name  String                 @db.VarChar(512)
  style        Json
  version      Int                    @default(1)
  created_at   DateTime               @default(now()) @db.Timestamptz(6)
  updated_at   DateTime               @default(now()) @updatedAt @db.Timestamptz(6)
  project      projects               @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  asset        assets                 @relation(fields: [asset_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  measurements project_measurements[]

  @@index([project_id, updated_at])
}

enum user_role {
  user
  admin
}

// Points are absolute IFC Z-up coordinates in metres, independent of renderer origin.
model project_measurements {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id    String               @db.Uuid
  floor_plan_id String?              @db.Uuid
  created_by    String               @db.Uuid
  name          String               @db.VarChar(160)
  kind          measurement_kind
  points        Json
  version       Int                  @default(1)
  created_at    DateTime             @default(now()) @db.Timestamptz(6)
  updated_at    DateTime             @default(now()) @updatedAt @db.Timestamptz(6)
  project       projects             @relation(fields: [project_id], references: [id], onDelete: Cascade)
  floor_plan    project_floor_plans? @relation(fields: [floor_plan_id], references: [id], onDelete: Cascade)
  author        users                @relation(fields: [created_by], references: [id], onDelete: Restrict)

  @@index([project_id, updated_at])
  @@index([floor_plan_id])
}

enum measurement_kind {
  distance
  surface
}

model project_bim_filters {
  project_id String   @id @db.Uuid
  settings   Json
  version    Int      @default(1)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  project    projects @relation(fields: [project_id], references: [id], onDelete: Cascade)
}

model project_map_references {
  project_id String   @id @db.Uuid
  asset_id   String?  @unique @db.Uuid
  reference  Json
  created_at DateTime @default(now()) @db.Timestamptz(6)
  project    projects @relation(fields: [project_id], references: [id], onDelete: Cascade)
  asset      assets?  @relation(fields: [asset_id], references: [id], onDelete: SetNull)
}
